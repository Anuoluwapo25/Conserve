{
  "name": "@conserve/contract",
  "version": "0.4.0",
  "description": "Compact contract and witness bindings for Conserve.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./managed/*": "./managed/*",
    "./simulator": {
      "types": "./dist/simulator.d.ts",
      "default": "./dist/simulator.js"
    },
    "./demo-dollar": {
      "types": "./dist/demo-dollar.d.ts",
      "default": "./dist/demo-dollar.js"
    }
  },
  "files": [
    "dist",
    "managed",
    "src"
  ],
  "scripts": {
    "compact": "node scripts/compile.mjs",
    "build": "npm run compact && tsc -b",
    "test": "npm run compact && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
